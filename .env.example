# Copy to .env for local Docker Compose development.
# Replace every change-me value locally. Never commit the real .env file.

MYSQL_DATABASE=livestock_app
MYSQL_USER=livestock_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
JAVA_PORT=8080

REDIS_PASSWORD=change-me

JWT_SECRET=change-me-at-least-32-characters
JWT_ISSUER=livestock-business-service
JWT_AUDIENCE=livestock-business-api
# Leave empty for the same-origin UI served by Java. Add explicit origins only when needed.
CORS_ALLOWED_ORIGINS=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-characters
AI_SERVICE_TOKEN=change-me-at-least-32-characters
KNOWLEDGE_COLLECTION=test
AI_CHAT_MAX_CONCURRENT_CALLS=20

# The reproducible Compose profile intentionally uses config/settings.compose.yaml
# and RAG_QUERY_MODE=fake. Real RAG remains an explicit local/developer profile;
# see docs/V7_ARCHITECTURE_AND_BOUNDARIES.md.
